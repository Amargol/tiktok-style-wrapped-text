{
  "name": "tiktok-style-wrapped-text",
  "version": "0.2.0",
  "description": "TikTok-style captions with connected backgrounds, width snapping and glyph outlines",
  "type": "module",
  "main": "./roundtext.js",
  "types": "./roundtext.d.ts",
  "exports": {
    ".": {
      "types": "./roundtext.d.ts",
      "import": "./roundtext.js"
    },
    "./react": {
      "types": "./ReactRoundText.d.ts",
      "import": "./ReactRoundText.js"
    }
  },
  "files": [
    "roundtext.js",
    "roundtext.d.ts",
    "ReactRoundText.js",
    "ReactRoundText.d.ts",
    "ReactRoundText.tsx",
    "README.md",
    "LICENSE",
    "fonts/"
  ],
  "sideEffects": [
    "./roundtext.js"
  ],
  "license": "MIT",
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Amargol/tiktok-style-wrapped-text.git",
    "directory": "dist/lib"
  },
  "homepage": "https://amargol.github.io/tiktok-style-wrapped-text/",
  "keywords": [
    "tiktok",
    "text",
    "captions",
    "web-components",
    "react",
    "rounded-text"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
